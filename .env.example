# --- Database ---
DATABASE_URL=postgresql://widget_user:widget_pass@db:5432/widget_platform

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# --- Redis (rate limiting) ---
REDIS_URL=redis://redis:6379/0

# --- Geo enrichment providers (fallback chain) ---
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co
# Toggle these to simulate an outage deterministically for EVIDENCE.md / probes
GEO_PROVIDER_A_FORCE_DOWN=false
GEO_PROVIDER_B_FORCE_DOWN=false

# --- Email / webhook side effect ---
# "console" just logs; "webhook" POSTs to EMAIL_WEBHOOK_URL (e.g. a Mailpit/webhook.site test URL)
EMAIL_SIDE_EFFECT_MODE=console
EMAIL_WEBHOOK_URL=
# Force the side effect to throw, to prove it never blocks a submission (Probe 5)
EMAIL_SIDE_EFFECT_FORCE_FAIL=false

# --- CORS ---
# Comma-separated list of allowed customer-site origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Rate limiting ---
RATE_LIMIT_PER_IP=10/minute
RATE_LIMIT_PER_WIDGET=30/minute

# --- Widget bundle version (bump to cache-bust) ---
WIDGET_BUNDLE_VERSION=v1
